{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "paths": { "@lamp/design-system": ["./dist/index.d.ts"] }
  },
  "include": ["test/**/*.tsx", "dist/index.d.ts"]
}
