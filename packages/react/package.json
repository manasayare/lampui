{
  "name": "@lamp/design-system",
  "version": "0.1.0",
  "description": "React components for LAMP — the enterprise AI operating environment. Tokens, primitives, and the Agent / Playbook / Genie object system.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./dist/assets/*": "./dist/assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17",
    "gsap": ">=3.11"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    }
  }
}
