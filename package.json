{
  "name": "lamp-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "LAMP Design System \u2014 tokens, primitives and LAMP object components for the enterprise AI operating environment.",
  "type": "module",
  "scripts": {
    "build": "node tools/build-bundle.mjs",
    "assets": "node tools/vendor-assets.mjs",
    "check": "node tools/build-bundle.mjs && node tools/check-system.mjs",
    "verify": "node tools/build-bundle.mjs && node tools/verify-browser.mjs",
    "test": "npm run check && node tools/verify-browser.mjs",
    "dev": "node tools/build-bundle.mjs && vite --config tools/vite.config.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/standalone": "^7.26.4",
    "@material-symbols/svg-400": "^0.28.0",
    "geist": "^1.3.1",
    "playwright": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^13.21.0",
    "vite": "^5.4.11"
  }
}
